{
  "name": "bugboo",
  "displayName": "BugBoo 👻",
  "description": "A playful pixel-art ghost companion that reacts to your real coding events, errors, and progress in VS Code.",
  "version": "0.2.0",
  "publisher": "kiranmayee-abbireddy",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiranmayee-abbireddy/BugBoo.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "companion",
    "pet",
    "mascot",
    "gamification",
    "productivity",
    "pixel-art",
    "ghost",
    "diagnostics"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "type": "webview",
          "id": "bugboo.sidebarView",
          "name": "BugBoo 👻"
        }
      ]
    },
    "commands": [
      {
        "command": "bugboo.summon",
        "title": "BugBoo: Summon",
        "category": "BugBoo"
      },
      {
        "command": "bugboo.changeMood",
        "title": "BugBoo: Change Mood",
        "category": "BugBoo"
      },
      {
        "command": "bugboo.changeColor",
        "title": "BugBoo: Customize Avatar Color",
        "category": "BugBoo"
      },
      {
        "command": "bugboo.showStats",
        "title": "BugBoo: Show Stats",
        "category": "BugBoo"
      },
      {
        "command": "bugboo.resetProgress",
        "title": "BugBoo: Reset Progress",
        "category": "BugBoo"
      }
    ],
    "configuration": {
      "title": "BugBoo",
      "properties": {
        "bugboo.avatarColor": {
          "type": "string",
          "default": "lavender",
          "enum": [
            "lavender",
            "mint",
            "cyberpunk",
            "rose",
            "midnight",
            "sunshine",
            "spectral"
          ],
          "enumDescriptions": [
            "Classic Lavender Ghost (#D8B4FE)",
            "Fresh Mint Green Ghost (#6EE7B7)",
            "Neon Cyan Cyberpunk Ghost (#67E8F9)",
            "Pastel Rose Pink Ghost (#F472B6)",
            "Dark Slate Midnight Ghost (#94A3B8)",
            "Bright Sunshine Gold Ghost (#FDE047)",
            "Pure Spectral White Ghost (#F8FAFC)"
          ],
          "description": "Select the color theme for your BugBoo companion avatar."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "mocha ./out/test/**/*.test.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "typescript": "^5.3.3"
  }
}
